API_DOMAIN=api.example.com
AUTH_DOMAIN=auth.example.com
ACME_EMAIL=you@example.com

# Frontend origin allowed by CORS / WebSocket (exact origin, no trailing slash)
ALLOWED_ORIGINS=https://app.example.com

POSTGRES_DB=sonant
POSTGRES_USER=sonant
POSTGRES_PASSWORD=change-me

RABBITMQ_USER=sonant
RABBITMQ_PASSWORD=change-me

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# Realm your frontend logs into. Create a dedicated realm in Keycloak and set it here.
KEYCLOAK_REALM=master

AWS_ACCESS_KEY=change-me
AWS_SECRET_KEY=change-me